# คัดลอกไปไว้ที่ ~/.config/harnkan/.env (นอกรีโป) แล้วใส่ค่าจริง — ห้าม commit ไฟล์ที่มีค่าจริง
# โหมด fake: 1 = ไม่ต่อของจริง (dev/เทสต์ต้องเป็น 1 เสมอ)
FAKE_LINE=1
FAKE_AI=1

# ที่เก็บข้อมูลรันไทม์ (DB รูปสลิป log)
DATA_DIR=./.data
BACKUP_DIR=./.data/backups
BACKUP_KEEP=7
SLIP_RETENTION_DAYS=365

# server (bind 127.0.0.1 เท่านั้น — ของจริงเปิดผ่าน cloudflared)
HOST=127.0.0.1
PORT=8787
PUBLIC_BASE_URL=https://harnkan.example.com

# LINE Messaging API (ต้องใช้เมื่อ FAKE_LINE=0)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Login channel ของ LIFF / MINI App (ใช้ตรวจ ID token)
LIFF_CHANNEL_ID=
LIFF_ID=

# ตัวอ่านสลิป (ใช้เมื่อ FAKE_AI=0) · gemini (ค่าเริ่ม) หรือ claude
AI_PROVIDER=gemini
# ชื่อรุ่น — gemini ไม่มีค่าเริ่มต้น ต้องเลือกจากรายชื่อรุ่นใน AI Studio (ดู docs/SETUP-CREDENTIALS.md) · claude ถ้าว่างใช้ claude-haiku-4-5
SLIP_MODEL=
# Gemini API key จาก AI Studio (โปรเจกต์ที่เปิด billing แล้วเท่านั้น ห้ามใช้ free tier กับสลิปจริง)
GEMINI_API_KEY=
# Anthropic (ใช้เมื่อ AI_PROVIDER=claude)
ANTHROPIC_API_KEY=
AI_DAILY_CAP=30

# ยอดขั้นต่ำที่จะส่งเรียกเก็บ (สตางค์) ต่ำกว่านี้ทบวันถัดไป
MIN_TRANSFER=5000

{
  "name": "harnkan",
  "version": "0.1.0",
  "description": "หารกัน — LINE bot + mini app หารค่าใช้จ่ายรายวันของคนสองคน",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "imports": {
    "#domain/*": "./src/domain/*"
  },
  "scripts": {
    "dev": "FAKE_LINE=1 FAKE_AI=1 DATA_DIR=./.data node --experimental-strip-types --experimental-sqlite --no-warnings src/server.ts",
    "start": "node --experimental-strip-types --experimental-sqlite --no-warnings src/server.ts",
    "test": "FAKE_LINE=1 FAKE_AI=1 HARNKAN_ENV=/dev/null node --experimental-strip-types --experimental-sqlite --no-warnings --test \"test/**/*.test.ts\"",
    "check": "node --experimental-strip-types --no-warnings scripts/check.ts",
    "job:summary": "node --experimental-strip-types --experimental-sqlite --no-warnings src/jobs/summary.ts",
    "job:backup": "node --experimental-strip-types --experimental-sqlite --no-warnings src/jobs/backup.ts",
    "job:retention": "node --experimental-strip-types --experimental-sqlite --no-warnings src/jobs/retention.ts",
    "demo": "node --experimental-strip-types --no-warnings scripts/demo-server.ts",
    "fixtures": "node --experimental-strip-types --no-warnings test/fixtures/make-slips.ts",
    "dev:seed": "FAKE_LINE=1 FAKE_AI=1 DATA_DIR=./.data node --experimental-strip-types --experimental-sqlite --no-warnings scripts/seed-dev.ts",
    "migrate": "node --experimental-strip-types --experimental-sqlite --no-warnings src/db/schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "jimp": "^1.6.1",
    "jsqr": "^1.4.0",
    "promptparse": "^1.7.0",
    "qrcode": "^1.5.4"
  }
}
